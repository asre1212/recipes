{
 "name":"recipe-drive-backups",
 "main":"worker.js",
 "compatibility_date":"2026-11-27",
 "workers_dev":true,
 "assets":{"directory":"../dist","binding":"ASSETS","run_worker_first":["/api/*","/auth/*","/health"]},
 "observability":{"enabled":false},
 "durable_objects":{"bindings":[{"name":"BACKUP","class_name":"DriveCoordinator"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["DriveCoordinator"]}],
 "keep_vars":true
}
